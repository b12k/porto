{
  "name": "@b12k/porto",
  "version": "0.0.0",
  "description": "Port range allocator for git worktrees",
  "keywords": [
    "cli",
    "git",
    "ports",
    "worktree"
  ],
  "license": "MIT",
  "author": "Bogdan Kolesnyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b12k/porto.git"
  },
  "bin": {
    "porto": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "check": "run-p -l check:*",
    "check:format": "oxfmt . --check",
    "check:scripts": "oxlint",
    "check:types": "tsc --noEmit",
    "check:tests": "rstest run",
    "deps:check": "ncu -e 2 -c 1",
    "deps:update": "ncu -du --doctorInstall \"pnpm deps:update:install\" --doctorTest \"pnpm deps:update:doctor\" -c 1",
    "deps:update:doctor": "run-p -l check:types check:scripts check:tests build",
    "deps:update:install": "pnpm i --no-frozen-lockfile",
    "dev": "rslib --watch",
    "fix": "run-s -l fix:*",
    "fix:format": "oxfmt . --write",
    "fix:scripts": "oxlint --fix",
    "ga:notify": "tsx .github/notify.ts",
    "husky:commit-msg": "commitlint",
    "husky:pre-commit": "lint-staged",
    "husky:pre-push": "branch-name-lint",
    "prepack": "run-p check build",
    "prepare": "husky",
    "release": "release-it",
    "test": "rstest run"
  },
  "dependencies": {
    "boxen": "9.0.0",
    "commander": "15.0.0",
    "cosmiconfig": "10.0.1",
    "es-toolkit": "1.53.1",
    "jiti": "2.7.0",
    "proper-lockfile": "4.1.2",
    "update-notifier": "7.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@b12k/branch-name-lint": "1.3.0",
    "@commitlint/config-conventional": "21.2.4",
    "@release-it/conventional-changelog": "12.0.2",
    "@rslib/core": "1.0.5",
    "@rstest/core": "0.12.6",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/update-notifier": "6.0.9",
    "commitlint": "21.2.4",
    "eslint-plugin-perfectionist": "5.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "release-it": "21.1.2",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
